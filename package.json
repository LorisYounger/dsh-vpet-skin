{
  "name": "dsh-client-vpet-skin",
  "version": "0.1.13",
  "description": "VPet：five illustrated forms with an adaptive reasoning slider for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LorisYounger/dsh-vpet-skin.git"
  },
  "homepage": "https://github.com/LorisYounger/dsh-vpet-skin#readme",
  "bugs": "https://github.com/LorisYounger/dsh-vpet-skin/issues",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/vpet/",
    "cordis.patch.yml",
    "lib/client.js",
    "lib/client.js.map",
    "src/index.js",
    "src/range.js",
    "src/portraits.js"
  ],
  "scripts": {
    "build": "node ./scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0"
  }
}
